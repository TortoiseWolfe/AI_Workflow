# TSD_AI_Workflow .env.example
# This repo is documentation; no app config required by default.
# Add variables here as the curriculum grows tooling that needs them.
#
# Rule: committed files may reference variable NAMES but must NEVER contain real secrets.
# Pattern: use ${VAR:-inert-placeholder} in any scripts that read these.

# tsd-curriculum-deploy PAT — set in local .env, never commit a real value here
GITHUB_TOKEN=set-in-env-file
